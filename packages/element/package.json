{
  "name": "@image-aware/element",
  "version": "0.1.0",
  "description": "The <image-surface> custom element: render live HTML onto flat surfaces in a photograph.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/auto.js"],
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@image-aware/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
