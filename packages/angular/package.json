{
  "name": "@image-aware/angular",
  "version": "0.1.0",
  "description": "Angular bindings for <image-surface>: render live HTML onto flat surfaces in a photograph.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@image-aware/core": "workspace:*",
    "@image-aware/element": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": ">=17"
  },
  "devDependencies": {
    "@angular/core": "^20.2.1",
    "rxjs": "~7.8.0",
    "typescript": "^5.9.3",
    "zone.js": "~0.15.0"
  }
}
