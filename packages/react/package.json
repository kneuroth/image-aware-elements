{
  "name": "@image-aware/react",
  "version": "0.1.0",
  "description": "React bindings for <image-surface>: render live HTML onto flat surfaces in a photograph.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@image-aware/core": "workspace:*",
    "@image-aware/element": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "react": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kneuroth/image-aware-elements.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/kneuroth/image-aware-elements/tree/main/packages/react#readme",
  "bugs": "https://github.com/kneuroth/image-aware-elements/issues"
}
