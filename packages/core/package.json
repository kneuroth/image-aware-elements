{
  "name": "@image-aware/core",
  "version": "0.1.0",
  "description": "Framework-agnostic math for mapping HTML onto flat surfaces in a photograph. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "keywords": ["homography", "matrix3d", "perspective", "css-transform", "photo"],
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
